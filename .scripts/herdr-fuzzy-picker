#!/usr/bin/env python3
"""
Herdr Fuzzy Picker
Fast fuzzy picker across agents, worktrees, and panes with rich live preview.
By default searches metadata (topics, PRs, branches, commands, paths).
Deep buffer text search is available on demand via Ctrl-T or --content.
"""

import os
import sys
import json
import re
import socket
import subprocess
from concurrent.futures import ThreadPoolExecutor

SOCKET_PATH = os.path.expanduser("~/.config/herdr/herdr.sock")
HOME = os.path.expanduser("~")

# ANSI styling
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
ITALIC = "\033[3m"

# Palette (Tokyo Night aligned)
CYAN = "\033[38;2;122;162;247m"       # #7aa2f7
MAGENTA = "\033[38;2;187;154;247m"   # #bb9af7
GREEN = "\033[38;2;158;206;106m"     # #9ece6a
YELLOW = "\033[38;2;224;175;104m"    # #e0af68
ORANGE = "\033[38;2;255;158;100m"    # #ff9e64
RED = "\033[38;2;247;118;142m"       # #f7768e
GRAY = "\033[38;2;86;95;137m"        # #565f89
WHITE = "\033[38;2;192;202;245m"     # #c0caf5

STATUS_ICONS = {
    "idle": "💤",
    "working": "⏳",
    "done": "✅",
    "blocked": "⚠️",
    "unknown": "❓"
}

def rpc_call(method, params=None, req_id="1", timeout=1.0):
    """Execute a single RPC request over the Herdr Unix domain socket."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCKET_PATH)
        msg = {"id": req_id, "method": method, "params": params or {}}
        s.sendall(json.dumps(msg).encode("utf-8") + b"\n")
        data = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
            if b"\n" in chunk:
                break
        s.close()
        return json.loads(data.decode("utf-8"))
    except Exception:
        # Fallback to CLI if socket fails
        try:
            cmd = ["herdr", "api", "snapshot"] if method == "session.snapshot" else None
            if cmd:
                out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL, timeout=timeout)
                return json.loads(out)
        except Exception:
            pass
        return {}

def get_snapshot():
    """Retrieve full Herdr session snapshot."""
    res = rpc_call("session.snapshot")
    if "result" in res:
        return res["result"].get("snapshot", {})
    return {}

def read_pane_buffer(pane_id, lines=20, strip_ansi=True):
    """Read recent buffer text for a given pane."""
    res = rpc_call("pane.read", {
        "pane_id": pane_id,
        "source": "recent",
        "lines": lines,
        "strip_ansi": strip_ansi
    })
    return res.get("result", {}).get("read", {}).get("text", "")

def format_path(path):
    if not path:
        return ""
    if path.startswith(HOME):
        return "~" + path[len(HOME):]
    return path

def clean_snippet(text, max_len=180):
    """Clean and flatten terminal text into a single searchable line."""
    if not text:
        return ""
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    joined = " ".join(lines)
    joined = re.sub(r"[\x00-\x1f\x7f-\x9f]", "", joined)
    joined = re.sub(r"\s+", " ", joined)
    return joined[:max_len]

